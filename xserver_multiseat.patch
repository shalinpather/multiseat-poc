From: Pixo
Subject: Add DRM lease manager support to modesetting driver and Glamor DRI3
Origin: https://forum.level1techs.com/t/drm-lease-manager-service/197584/5

Patch originally posted by Pixo on the Level1Techs forum (2024/12/19 20:03:00)
for upstream xorg-server (MIT/X11 license) to integrate AGL's drm-lease-manager
(libdlmclient).

diff --git a/glamor/glamor_egl.c b/glamor/glamor_egl.c
index 6e0fc6596..e9d704327 100644
--- a/glamor/glamor_egl.c
+++ b/glamor/glamor_egl.c
@@ -803,7 +803,13 @@ glamor_dri3_open_client(ClientPtr client,
 
     fd = open(glamor_egl->device_path, O_RDWR|O_CLOEXEC);
     if (fd < 0)
-        return BadAlloc;
+    {
+        /* Lets try open render node because we may be running atop DRM lease */
+        glamor_egl->device_path = drmGetRenderDeviceNameFromFd(glamor_egl->fd);
+        fd = open(glamor_egl->device_path, O_RDWR|O_CLOEXEC);
+        if (fd < 0)
+            return BadAlloc;
+    }
 
     /* Before FD passing in the X protocol with DRI3 (and increased
      * security of rendering with per-process address spaces on the
diff --git a/hw/xfree86/drivers/modesetting/driver.c b/hw/xfree86/drivers/modesetting/driver.c
index 535f49d1d..186cbe1ae 100644
--- a/hw/xfree86/drivers/modesetting/driver.c
+++ b/hw/xfree86/drivers/modesetting/driver.c
@@ -63,6 +63,9 @@
 #include <pciaccess.h>
 #endif
 #include "driver.h"
+/* dlmclient start */
+#include <libdlmclient/dlmclient.h>
+/* dlmclient end */
 
 static void AdjustFrame(ScrnInfoPtr pScrn, int x, int y);
 static Bool CloseScreen(ScreenPtr pScreen);
@@ -219,6 +222,27 @@ get_passed_fd(void)
     return -1;
 }
 
+/* dlmclient start */
+static struct dlm_lease *
+get_dlm_lease(const char *dev)
+{
+    struct dlm_lease *dml_lease;
+
+    if ((NULL == dev) || ((strcmp(dev,"DLMClient")) == 0))
+        dev = SeatId;
+
+    dml_lease = dlm_get_lease(dev);
+
+    if (!dml_lease) {
+        xf86DrvMsg(-1, X_INFO, "Could not obtain lease for %s\n", dev);
+        return NULL;
+    }
+
+    xf86DrvMsg(-1, X_INFO, "Received lease for %s\n", dev);
+    return dml_lease;
+}
+/* dlmclient end */
+
 static int
 open_hw(const char *dev)
 {
@@ -267,6 +291,26 @@ check_outputs(int fd, int *count)
     return ret;
 }
 
+/* dlmclient start */
+static Bool
+probe_dlm(const char *dev)
+{
+    int fd;
+    struct dlm_lease *dml_lease;
+
+    dml_lease = get_dlm_lease(dev);
+    fd = dlm_lease_fd(dml_lease);
+    if (fd != -1) {
+        int ret = check_outputs(fd, NULL);
+        dlm_release_lease(dml_lease);
+        close(fd);
+        return ret;
+    }
+
+    return FALSE;
+}
+/* dlmclient end */
+
 static Bool
 probe_hw(const char *dev, struct xf86_platform_device *platform_dev)
 {
@@ -288,6 +332,11 @@ probe_hw(const char *dev, struct xf86_platform_device *platform_dev)
         close(fd);
         return ret;
     }
+
+/* dlmclient start */
+    return probe_dlm(dev);
+/* dlmclient end */
+
     return FALSE;
 }
 
@@ -869,6 +918,12 @@ FreeRec(ScrnInfoPtr pScrn)
             ms_unwrap_property_requests(pScrn);
             if (ms->pEnt->location.type == BUS_PCI)
                 ret = drmClose(ms->fd);
+/* dlmclient start */
+            else if (ms->dlmLease) {
+                ret = close(ms->fd);
+                dlm_release_lease(ms->dlmLease);
+            }
+/* dlmclient end */
             else
 #ifdef XF86_PDEV_SERVER_FD
                 if (!(ms->pEnt->location.type == BUS_PLATFORM &&
@@ -1052,6 +1107,13 @@ ms_get_drm_master_fd(ScrnInfoPtr pScrn)
     {
         const char *devicename;
         devicename = xf86FindOptionValue(ms->pEnt->device->options, "kmsdev");
+/* dlmclient start */
+        ms->dlmLease = get_dlm_lease(devicename);
+        if (ms->dlmLease) {
+            ms->fd_passed = TRUE;
+            ms->fd = dlm_lease_fd(ms->dlmLease);
+        } else
+/* dlmclient end */
         ms->fd = open_hw(devicename);
     }
     if (ms->fd < 0)
